        [Test]
        public void Test01_CarExistsAsync_ReturnsTrue_WhenCarExists()
        {
            // Arrange
            string userId = Guid.NewGuid().ToString();
            Car car = new Car
            {
                Id = Guid.NewGuid(),
                Brand = "Toyota",
                Model = "Camry",
                Year = 2020,
                Price = 25000,
                Mileage = 10000,
                EngineType = EngineType.Gasoline,
                TransmissionType = TransmissionType.Automatic,
                HorsePower = 200,
                State = State.New,
                Description = "A reliable car.",
                SellerId = userId,
                CreatedOn = DateTime.Now
            };
            List<Car> cars = new List<Car>() { car };
            IQueryable<Car> carsQueryableMock = cars.AsQueryable().BuildMock();
            var carId = car.Id;
            carServiceMock.Setup(service => service.CarExistsAsync(carId)).ReturnsAsync(true);
            // Act
            var result = carServiceMock.Object.CarExistsAsync(carId).Result;
            // Assert
            Assert.IsTrue(result);
        }
