@using WebApplication1.ViewModels.AdminPanelViewModels
@using static WebApplication1.GCommon.ApplicationConstants
@model DeleteCarViewModel
@{
    ViewBag.Title = "Delete car confiration (Only for admins)";
}
<h1>Are you sure you want to delete this car?</h1>
@if (Model.Image == null)
{
    <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
}
else
{
    <img src="@Url.Action("Image", "Car", new { id = Model.Id })" alt="No photo" style="width: 120px; height: 80px; object-fit: cover;" />
}
<p>ID: @Model.Id</p>
<p>Brand: @Model.Brand</p>
<p>Model: @Model.Model</p>
<p>Year: @Model.Year</p>
<p>Price: @Model.Price.ToString(PriceFormat)</p>
<p>Created on: @Model.CreatedOn.ToString(DateFormat)</p>
<h2>Seller information</h2>
<p>First name: @Model.SellerFirstName</p>
<p>Last name: @Model.SellerLastName</p>
<p>Username: @Model.SellerUsername</p>
<p>Town: @Model.TownName</p>
<p>Email: @Model.Email</p>
<p>Phone number: @Model.PhoneNumber</p>
<form asp-action="DeleteCarConfirmation" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes</button>
    <a asp-action="Index" class="btn btn-secondary">No</a>
</form>