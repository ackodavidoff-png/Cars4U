@using WebApplication1.ViewModels.AdminPanelViewModels
@model IQueryable<TownManagerViewModel>
@{
    ViewBag.Title = "Town manager (Only for admins)";
}
<h1>Town manager 🏙️🛠️</h1>
<form asp-controller="Admin" asp-action="CreateTown" method="post">
    <input type="text" name="townName" value="@Context.Request.Query["add"]" placeholder="Add town name" />
    <button type="submit">Add</button>
</form>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Town ID</th>
            <th>Name</th>
            <th>Users count</th>
            <th>Cars count</th>
            <th>Details</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (TownManagerViewModel town in Model)
        {
            string deleteDisabled = town.UsersCount == 0 && town.CarsCount == 0 ? "" : "disabled";
            <tr>
                <th>@town.Id</th>
                <th>@town.Name</th>
                <th>@town.UsersCount</th>
                <th>@town.CarsCount</th>
                <th>
                    <a class="btn btn-primary" asp-area="" asp-controller="Town" asp-action="Details" asp-route-id="@town.Id">Details</a>
                </th>
                <th>
                    <form asp-controller="Admin" asp-action="EditTownName" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@town.Id" />
                        <input type="text" name="name" value="@town.Name" class="form-control" required/>
                        <button type="submit" class="btn btn-primary">Edit</button>
                    </form>
                </th>
                <th>
                    <a class="btn btn-danger @deleteDisabled" asp-area="" asp-controller="Admin" asp-action="DeleteTown" asp-route-id="@town.Id">Delete</a>
                </th>
            </tr>
        }
    </tbody>
</table>