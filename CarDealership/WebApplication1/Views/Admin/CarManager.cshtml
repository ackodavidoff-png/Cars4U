@using WebApplication1.GCommon
@using WebApplication1.ViewModels.AdminPanelViewModels
@using static WebApplication1.GCommon.ApplicationConstants
@model PaginatedList<CarManagerViewModel>
@{
    ViewBag.Title = "Car manager (Only for admins)";
}
<h1>Car manager 🚗🛠️</h1>
@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Photo</th>
                <th>Brand and model</th>
                <th>Seller ID</th>
                <th>Seller full name</th>
                <th>Seller details</th>
                <th>Price</th>
                <th>Added on</th>
                <th>Details</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CarManagerViewModel car in Model)
            {
                <tr>
                    <th>@car.Id</th>
                    <td>
                        @if (car.Image == null)
                        {
                            <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="@Url.Action("Image", "Car", new { id = car.Id })" alt="No photo" style="width: 120px; height: 80px; object-fit: cover;" />
                        }
                    </td>
                    <th>@car.Brand @car.Model</th>
                    <th>@car.SellerId</th>
                    <th>@car.SellerFirstName @car.SellerLastName (@car.SellerUsername)</th>
                    <th>
                        <a class="btn btn-primary" asp-area="" asp-controller="User" asp-action="Details" asp-route-id="@car.SellerId">Seller's details</a>
                    </th>
                    <th>@car.Price.ToString(PriceFormat)</th>
                    <th>@car.CreatedOn.ToString(DateFormat)</th>
                    <th>
                        <a class="btn btn-primary" asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@car.Id">Details</a>
                    </th>
                    <th>
                        <a asp-area="" asp-controller="Admin" asp-action="DeleteCar" asp-route-id="@car.Id" class="btn btn-danger">Delete</a>
                    </th>
                </tr>
            }
        </tbody>
    </table>
}
@{
    string prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    string nextDisabled = !Model.HasNextPage ? "disabled" : "";
}
<a asp-action="CarManager" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-default @prevDisabled">Previous</a>
@for (int i = 1; i <= Model.TotalPages; i++)
{
    if (i == Model.PageIndex)
    {
        <a asp-action="CarManager" asp-route-pageNumber="@i" class="btn btn-default disabled">@i</a>
    }
    else
    {
        <a asp-action="CarManager" asp-route-pageNumber="@i" class="btn btn-default">@i</a>
    }
}
<a asp-action="CarManager" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-default @nextDisabled">Next</a>