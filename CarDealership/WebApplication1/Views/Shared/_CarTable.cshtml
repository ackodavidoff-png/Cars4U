@using WebApplication1.Common
@using WebApplication1.Data.Models
@model PaginatedList<Car>
@{
}
<table class="table table-striped">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Price</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Car car in Model)
        {
            <tr>
                <td>
                    @if (car.Image == null)
                    {
                        <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="@Url.Action("Image", "Car", new { id = car.Id })" alt="No photo" style="width: 120px; height: 80px; object-fit: cover;" />
                    }
                </td>
                <th>@car.Brand</th>
                <th>@car.Model</th>
                <th>@(car.Price.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ")) €</th>
                <th>
                    <a class="btn btn-primary" asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@car.Id">Details</a>
                </th>
            </tr>
        }
    </tbody>
</table>
@{
    string prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    string nextDisabled = !Model.HasNextPage ? "disabled" : "";
}
<a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-default @prevDisabled">Previous</a>
@for (int i = 1; i <= Model.TotalPages; i++)
{
    if (i == Model.PageIndex)
    {
        <a asp-action="Index" asp-route-pageNumber="@i" class="btn btn-default disabled">@i</a>
    }
    else
    {
        <a asp-action="Index" asp-route-pageNumber="@i" class="btn btn-default">@i</a>
    }
}
<a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-default @nextDisabled">Next</a>