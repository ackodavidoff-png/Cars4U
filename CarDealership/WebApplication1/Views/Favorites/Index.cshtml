@using WebApplication1.GCommon
@using WebApplication1.Data.Models
@model PaginatedList<Favorite>
@{
    ViewBag.Title = "Favorites";
}
<h1>Favorites ❤️</h1>
@if (!Model.Any())
{
    <p>No favorites</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Brand and model</th>
                <th>Price</th>
                <th>Details</th>
                <th>Remove</th>
            </tr>
        </thead>
        @foreach (Favorite favorite in Model)
        {
            <tr>
                <td>
                    @if (favorite.Car.Image == null)
                    {
                        <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="@Url.Action("Image", "Car", new { id = favorite.Car.Id })" alt="No photo" style="width: 120px; height: 80px; object-fit: cover;" />
                    }
                </td>
                <th>@favorite.Car.Brand @favorite.Car.Model</th>
                <th>@favorite.Car.Price.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ") €</th>
                <th>
                    <a class="btn btn-primary" asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@favorite.Car.Id">Details</a>
                </th>
                <th>
                    @*<a class="btn btn-danger" asp-area="" asp-controller="Favorites" asp-action="Remove" asp-route-id="@favorite.CarId">Remove</a>*@
                    <form asp-controller="Favorites" asp-action="Remove" method="post">
                        <input type="hidden" name="carId" value="@favorite.CarId" />
                        <button type="submit" class="btn btn-danger">❤️Remove</button>
                    </form>
                </th>
            </tr>
        }
    </table>
}