@using WebApplication1.Data.Models
@using WebApplication1.Common
@model ApplicationUser
@{
    ViewBag.Title = $"{Model.FirstName} {Model.LastName}";
}
<h1>@Model.FirstName @Model.LastName (@Model.UserName)</h1>
<h2>Contact information</h2>
<p>Phone number: @Model.PhoneNumber</p>
<p>Town: @Model.Town.Name</p>
<p>@(Model.Email == null ? null : $"Email: {Model.Email}")</p>
@if (Model.IsAdmin)
{
    <p>This user is an administrator</p>
}
<h2>Cars</h2>
@if (Model.Cars.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Brand</th>
                <th>Model</th>
                <th>Price</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Car car in Model.Cars)
            {
                <tr>
                    <td>
                        @if (car.Image == null)
                        {
                            <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="@Url.Action("Image", "Car", new { id = car.Id })" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
                        }
                    </td>
                    <th>@car.Brand</th>
                    <th>@car.Model</th>
                    <th>@(car.Price.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ")) €</th>
                    <th>
                        <a class="btn btn-primary" asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@car.Id">Details</a>
                    </th>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>This user has no cars</p>
}