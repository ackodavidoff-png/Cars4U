@using WebApplication1.ViewModels.CarViewModels
@using static WebApplication1.GCommon.ApplicationConstants
@model DeleteCarViewModel
@{
    ViewBag.Title = "Car delete confirmation";
}
<h1>Delete car</h1>
<p>Are you sure you want to delete this car?</p>
@if (Model.Image == null)
{
    <img src="/NoPhoto.png" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
}
else
{
    <img src="@Url.Action("Image", "Car", new { id = Model.Id })" alt="" style="width: 120px; height: 80px; object-fit: cover;" />
}
<h2>@Model.Brand @Model.Model</h2>
<p>Year: @Model.Year</p>
<p>@(Model.Price.ToString(PriceFormat, System.Globalization.CultureInfo.InvariantCulture).Replace(",", " "))€</p>
<a class="btn btn-primary" asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@Model.Id">More details</a>
<br />
<form asp-action="DeleteConfirmation" method="post">
    <input type="hidden" asp-for="Id"/>
    <button type="submit" class="btn btn-danger">Yes</button>
    <a asp-action="Index" class="btn btn-secondary">No</a>
</form>