@using WebApplication1.Data.Models
@using WebApplication1.Data.Models.Enums
@using WebApplication1.ViewModels
@model CreateCarViewModel
@{
    ViewBag.Title = "Add car";
}
<h1>Add car</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" type="number"/>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01"/>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Mileage" class="form-label"></label>
        <input asp-for="Mileage" class="form-control" type="number"/>
        <span asp-validation-for="Mileage" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EngineType" class="form-label">Engine type</label>
        <select asp-for="EngineType" asp-items="Html.GetEnumSelectList<EngineType>()" class="form-select">
            <option value="">-- Select engine type --</option>
        </select>
        <span asp-validation-for="EngineType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TransmissionType" class="form-label">Transmission type</label>
        <select asp-for="TransmissionType" asp-items="Html.GetEnumSelectList<TransmissionType>()" class="form-select">
            <option value="">-- Select transmission type --</option>
        </select>
        <span asp-validation-for="TransmissionType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HorsePower" class="form-label"></label>
        <input asp-for="HorsePower" class="form-control" type="number" />
        <span asp-validation-for="HorsePower" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="image">Car photo</label>
        <input type="file" id="image" name="image" accept="image/*" />
    </div>
    <div class="mb-3">
        <label asp-for="State" class="form-label"></label>
        <select asp-for="State" asp-items="Html.GetEnumSelectList<State>()" class="form-select"></select>
        <span asp-validation-for="State" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>