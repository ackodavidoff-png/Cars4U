@using WebApplication1.Data.Models
@using WebApplication1.Common
@model PaginatedList<Car>
@{
    ViewBag.Title = "Search results";
}
<h1>Search restults</h1>
<form asp-controller="Car" asp-action="Search" method="get">
    <input type="text" name="searchText" value="@Context.Request.Query["search"]" placeholder="Search cars (e.g. Ford)" />
    <button type="submit">Search</button>
</form>
@if (Model.Any())
{
    <partial name="_CarTable" model="Model" />
}
else
{
    <p>No cars found</p>
}